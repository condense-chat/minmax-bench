.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.hf_cache/
dist/
build/
*.egg-info/
out/
*.json.local
data/cache/
.DS_Store

# Quality bench: results/ is purely generated output (Harbor runs, replays, reports —
# large; embed task transcripts). The committed offline demo lives in runs/quality-sample/
# next to the cost bench's committed reference runs.
results/

# Generated cost-bench runs (each `runs/run-<uuid>/`). The committed reference runs are
# already tracked (gitignore doesn't untrack them) and runs/quality-sample/ doesn't match,
# so both stay; commit a NEW reference run deliberately with `git add -f`.
runs/run-*/

# Generated quality-bench runs (QUALITY_RUNS_DIR, `runs/quality/{full,incremental}/…`).
# Incremental replays embed the content of whichever local session was replayed, so this
# must not be committable by accident. runs/quality-sample/ (the offline demo) is a
# different path and stays tracked.
runs/quality/

.headroom/
.playwright-mcp/
scratchpad/
*.nohup
**/.DS_Store
/report.html
/report.md
